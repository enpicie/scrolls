# Supabase — get these from your Supabase project dashboard: https://app.supabase.com
# Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=                   # e.g. https://xyzxyzxyz.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=       # safe to expose — RLS enforces access
SUPABASE_SECRET_KEY=                        # NEVER prefix NEXT_PUBLIC_ — NEVER in browser code

# Sentry — from your Sentry project settings: https://sentry.io
# DSN: Project > Settings > Client Keys (DSN) — public value, safe to expose
NEXT_PUBLIC_SENTRY_DSN=
# Auth token: used for source map uploads at build time — keep secret
# Settings > Auth Tokens, or generated by the Sentry wizard
# Store in .env.sentry-build-plugin locally (already gitignored) and as a Vercel env var in production
SENTRY_AUTH_TOKEN=

# Claude API — for AI summary generation on scroll publish
# https://console.anthropic.com/
ANTHROPIC_API_KEY=

# GitHub OAuth — for repo-managed scroll syncing
# The GitHub token is managed by Supabase Auth, not stored here directly.
# Ensure your Supabase GitHub OAuth provider has the `repo` read scope configured.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000   # change to your production URL in Vercel env vars
